<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.nethergames.observer</groupId>
    <artifactId>observer</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <modules>
        <module>data</module>
        <module>client</module>
        <module>server</module>
    </modules>

    <properties>
        <revision>2.3.7</revision>

        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <jackson-databind.version>2.17.2</jackson-databind.version>
        <io.micrometer.version>1.13.2</io.micrometer.version>
        <kafka.version>3.7.1</kafka.version>
        <ng-data-utils.version>1.0-SNAPSHOT</ng-data-utils.version>
    </properties>

    <distributionManagement>
        <repository>
            <id>nethergamesmc</id>
            <name>NetherGames target repository</name>
            <url>https://repo.nethergames.org/repository/NetherGamesMC/</url>
        </repository>
    </distributionManagement>

    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
        <repository>
            <id>annotations</id>
            <url>https://repo.panda-lang.org/releases</url>
        </repository>

        <repository>
            <id>nethergamesmc</id>
            <name>NetherGames target repository</name>
            <url>https://repo.nethergames.org/repository/NetherGamesMC/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson-databind.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.34</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.6.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
